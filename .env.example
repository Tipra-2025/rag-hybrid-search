# PRECISION RAG — Environment Configuration
# Copy this file to .env and fill in your values.
# All variables are optional except RAG_OPENAI_API_KEY.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your OpenAI API key (or compatible provider key, e.g. Azure, Together, Groq)
RAG_OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# API Provider (optional — defaults to OpenAI)
# ---------------------------------------------------------------------------

# Base URL for the OpenAI-compatible API
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Models (optional — change to use different models)
# ---------------------------------------------------------------------------

# LLM for answer generation
# RAG_GENERATION_MODEL=gpt-4o

# Embedding model
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# LLM judge for citation verification
# RAG_JUDGE_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Reranking
# ---------------------------------------------------------------------------

# Reranker kind: llm | cross-encoder | none
# RAG_RERANK_KIND=llm

# Model used when RAG_RERANK_KIND=llm
# RAG_RERANK_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Chunking (defaults apply if not set)
# ---------------------------------------------------------------------------

# Chunking strategy: recursive | fixed | semantic
# RAG_CHUNKING_STRATEGY=recursive

# Target tokens per chunk
# RAG_CHUNK_SIZE_TOKENS=512

# Token overlap between adjacent chunks
# RAG_CHUNK_OVERLAP_TOKENS=64

# Cosine similarity threshold for deduplication (0.0-1.0)
# RAG_DEDUP_COSINE_THRESHOLD=0.95

# Semantic chunker: min/max tokens per segment
# RAG_SEMANTIC_CHUNK_MIN_TOKENS=100
# RAG_SEMANTIC_CHUNK_MAX_TOKENS=600

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------

# Number of candidates from dense retrieval
# RAG_DENSE_TOP_K=20

# Number of candidates from BM25 sparse retrieval
# RAG_SPARSE_TOP_K=20

# RRF rank-discount constant: score = sum(1/(k + rank))
# RAG_RRF_K=60

# Final number of passages sent to LLM after reranking
# RAG_FINAL_TOP_K=5

# ---------------------------------------------------------------------------
# Generation / Confidence
# ---------------------------------------------------------------------------

# Retrieval confidence below this triggers "I don't know" response
# RAG_IDK_RETRIEVAL_THRESHOLD=0.35

# composite = w * citation_accuracy + (1-w) * retrieval_confidence
# RAG_JUDGE_WEIGHT=0.5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory for index files (dense + sparse stores)
# RAG_INDEX_DIR=data/index

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# API bind address
# RAG_API_HOST=0.0.0.0

# API port
# RAG_API_PORT=8100

# Log level: DEBUG | INFO | WARNING | ERROR
# RAG_LOG_LEVEL=INFO

# Request timeout in seconds
# RAG_REQUEST_TIMEOUT_S=30

# Max HTTP retries on transient errors
# RAG_MAX_RETRIES=3
